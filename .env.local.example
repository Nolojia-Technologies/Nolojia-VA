# ─────────────────────────────────────────────────────────────────────────────
# Local development
#
# D1, R2 and the Cloudflare Access vars are NOT set here — they are bindings and
# vars in wrangler.jsonc, and wrangler provides them. See docs/cloudflare-setup.md.
#
# The only real secret is RESEND_API_KEY. In production it goes in the Workers
# secret store (`wrangler secret put RESEND_API_KEY`), never in wrangler.jsonc.
# ─────────────────────────────────────────────────────────────────────────────

# Site URL used for canonical tags, OG images and admin links in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=notifications@nolojia.com
EMAIL_TO=info@nolojia.com
CAREERS_EMAIL=info@nolojia.com
